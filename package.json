{
  "name": "game-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "audit:public": "node scripts/audit-public.mjs",
    "security:toolchain": "node scripts/check-toolchain.mjs",
    "security:check": "node scripts/check-security.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "^2.0.1",
    "papaparse": "5.5.3",
    "react": "19.0.1",
    "react-data-grid": "7.0.0-beta.57",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.14.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
